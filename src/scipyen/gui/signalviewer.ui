  <action name="epochsInDataFromCursorsAction">
   <property name="icon">
    <iconset theme="preview-add-zone"/>
   </property>
   <property name="text">
    <string>Add Epoch From Vertical Cursors</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Creates an Epoch from several vertical cursors.&lt;/p&gt;&lt;p&gt;Creates an Epoch with &lt;span style=&quot; font-weight:700; font-style:italic;&quot;&gt;as many intervals as there are vertical cursors selected&lt;/span&gt; in a subsequent dialog.&lt;/p&gt;&lt;p&gt;The Epoch is embedded in the data.&lt;/p&gt;&lt;p&gt;The Epoch will have &lt;span style=&quot; text-decoration: underline;&quot;&gt;one interval for each selected vertical cursor&lt;/span&gt;, defined by &lt;span style=&quot; font-weight:700; font-style:italic;&quot;&gt;start&lt;/span&gt; and &lt;span style=&quot; font-weight:700; font-style:italic;&quot;&gt;duration&lt;/span&gt; attributes, centered on the cursors' horizontal (&lt;span style=&quot; font-weight:700; font-style:italic;&quot;&gt;x&lt;/span&gt;) coordinate, with duration equal to the cursors' horizontal window (&lt;span style=&quot; font-weight:700; font-style:italic;&quot;&gt;xwindow&lt;/span&gt;).&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="epochInDataFromSelectedCursorAction">
   <property name="icon">
    <iconset theme="preview-add-zone"/>
   </property>
   <property name="text">
    <string>Add Epoch From Selected Vertical Cursor</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Creates an Epoch from a single vertical cursor.&lt;/p&gt;&lt;p&gt;The Epoch is embedded in the data.&lt;/p&gt;&lt;p&gt;The Epoch will have &lt;span style=&quot; text-decoration: underline;&quot;&gt;one interval&lt;/span&gt;, defined by &lt;span style=&quot; font-weight:700; font-style:italic;&quot;&gt;start&lt;/span&gt; and &lt;span style=&quot; font-weight:700; font-style:italic;&quot;&gt;duration&lt;/span&gt; attributes, centered on the cursors' horizontal (&lt;span style=&quot; font-weight:700; font-style:italic;&quot;&gt;x&lt;/span&gt;) coordinate, with duration equal to the cursors' horizontal window (&lt;span style=&quot; font-weight:700; font-style:italic;&quot;&gt;xwindow&lt;/span&gt;).&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
  <action name="epochInDataBetweenCursors">
   <property name="icon">
    <iconset theme="preview-add-zone"/>
   </property>
   <property name="text">
    <string>Add Epoch Between Two Vertical Cursors</string>
   </property>
   <property name="toolTip">
    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Creates an epoch between two Vertical Cursors.&lt;/p&gt;&lt;p&gt;The Epoch is embedded in the data.&lt;/p&gt;&lt;p&gt;The Epochs will contain a single interval, between the two cursors &lt;span style=&quot; font-weight:700; font-style:italic;&quot;&gt;x&lt;/span&gt; coordinates.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
  </action>
