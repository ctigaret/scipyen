    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;When a single variable is selected in the workspace (User Variables tab), shows a file save dialog to choose among supported file types. &lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;When more than one variable is selected, saves all of them to HDF5 files named after the variable name (symbol) in the workspace.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
   </property>
   <property name="iconSize">
